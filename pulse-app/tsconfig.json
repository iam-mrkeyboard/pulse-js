{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "pulse-framework",
    "baseUrl": ".",
    "paths": {
      "pulse-framework": ["./node_modules/pulse-framework/src/index.ts"]
    }
  },
  "include": ["src/**/*", "pulse.config.ts"]
}
