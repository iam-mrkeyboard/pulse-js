<script>
  import Navbar from '../components/Navbar.pulse';
  import CodeSnippet from '../components/CodeSnippet.pulse';

  const [count, setCount] = createSignal(0);
  const [showCode, setShowCode] = createSignal(false);

  const doubled = createMemo(() => count * 2);
  </script>

<Navbar />

<main class="landing">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="badge">
        <span class="pulse-dot"></span>
        v0.16.0 • Built with Bun
      </div>
      <h1>Build <span class="gradient">Blazing Fast</span> Web Apps</h1>
      <p class="tagline">The modern web framework with fine-grained reactivity, islands architecture, and a runtime so small it's practically invisible.</p>
      
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">0.8KB</span>
          <span class="stat-label">Core Runtime</span>
        </div>
        <div class="stat">
          <span class="stat-value">3x</span>
          <span class="stat-label">Faster Builds</span>
        </div>
        <div class="stat">
          <span class="stat-value">0</span>
          <span class="stat-label">Config Needed</span>
        </div>
      </div>
      
      <div class="hero-actions">
        <a href="/docs" class="btn-primary">Get Started →</a>
        <a href="/examples" class="btn-secondary">View Examples</a>
      </div>
      
      <div class="hero-code">
        <pre><code>bun create pulse my-app
cd my-app
bun run dev</code></pre>
      </div>
    </div>
  </section>

  <!-- Why Pulse -->
  <section class="why-section">
    <h2>Why Developers Love Pulse</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Bun-Powered Speed</h3>
        <p>Built from the ground up for Bun - the all-in-one JavaScript runtime that makes Node.js feel slow. Cold starts in milliseconds, HMR updates under 100ms, and native TypeScript support without configuration.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🎯</div>
        <h3>Fine-Grained Reactivity</h3>
        <p>Signal-based state management means surgical DOM updates. When data changes, only the exact elements that depend on it update - no virtual DOM diffing, no wasted renders, just pure efficiency.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🏝️</div>
        <h3>Islands Architecture</h3>
        <p>Ship zero JavaScript by default. Interactive components hydrate independently - perfect for content-heavy sites where every kilobyte matters. Your users will thank you.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">📦</div>
        <h3>Tiny Runtime</h3>
        <p>The entire core runtime is just 0.8KB gzipped. Compare that to React's 42KB or Vue's 34KB. When you ship less code, your users experience faster load times.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Secure by Default</h3>
        <p>No eval(), no new Function(), no CSP violations. Pulse uses AST-based compilation that produces clean, minifiable code that passes the strictest security audits.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🎨</div>
        <h3>Scoped Styling</h3>
        <p>CSS is automatically scoped to components. No naming conflicts, no BEM conventions, no CSS-in-JS runtime overhead. Just write styles and they work.</p>
      </div>
    </div>
  </section>

  <!-- Code Demo -->
  <section class="demo-section">
    <div class="demo-content">
      <h2>Simple, Familiar Syntax</h2>
      <p>If you know HTML, CSS, and JavaScript, you already know Pulse. No JSX compilation, no special syntax - just clean, readable components.</p>
    </div>

    <!-- Live Preview -->
    <div class="demo-preview">
      <div class="preview-card">
        <h2>Count: {count}</h2>
        <p>Doubled: {doubled}</p>
        <button class="preview-btn" onClick={() => setCount(c => c + 1)}>
          Increment
        </button>
      </div>
    </div>

    <!-- Toggle Button -->
    <div class="toggle-container">
      <button 
        class={showCode ? 'btn-toggle active' : 'btn-toggle'} 
        onClick={() => setShowCode(!showCode)}
      >
        <span class="icon">{showCode ? '👁️' : '👨‍💻'}</span>
        {showCode ? 'Hide Code' : 'View Code'}
      </button>
    </div>

    <!-- Code Block (Conditional) -->
    <Show when={showCode}>
      <CodeSnippet />
    </Show>
  </section>

  <!-- Comparison -->
  <section class="comparison-section">
    <h2>How Pulse Stacks Up</h2>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th class="pulse-col">Pulse</th>
            <th>React</th>
            <th>Vue</th>
            <th>Svelte</th>
            <th>Solid</th>
            <th>Imba</th>
            <th>Astro</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Runtime Size</td>
            <td class="pulse-col highlight">~0.8KB</td>
            <td>42KB</td>
            <td>34KB</td>
            <td>2KB</td>
            <td>7KB</td>
            <td>16KB</td>
            <td>0KB*</td>
          </tr>
          <tr>
            <td>Reactivity</td>
            <td class="pulse-col highlight">Signals</td>
            <td>VDOM</td>
            <td>Proxy</td>
            <td>Compiler</td>
            <td>Signals</td>
            <td>Memoized</td>
            <td>Islands</td>
          </tr>
          <tr>
            <td>Bun Native</td>
            <td class="pulse-col highlight">✓ Yes</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>Adapter</td>
          </tr>
          <tr>
            <td>Islands</td>
            <td class="pulse-col highlight">✓ Built-in</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>Reference</td>
            <td>✗</td>
            <td>✓ Core</td>
          </tr>
          <tr>
            <td>Scoped CSS</td>
            <td class="pulse-col highlight">✓ Built-in</td>
            <td>Modules</td>
            <td>✓ Built-in</td>
            <td>✓ Built-in</td>
            <td>Unscoped</td>
            <td>✓ Built-in</td>
            <td>✓ Built-in</td>
          </tr>
          <tr>
            <td>No Config</td>
            <td class="pulse-col highlight">✓ Yes</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>✗</td>
            <td>✓ Yes</td>
            <td>✓ Yes</td>
          </tr>
        </tbody>
      </table>
      <p class="table-note">* Astro core is 0KB but requires UI frameworks (React/Vue/etc) for interactivity.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <h2>Ready to Build Something Amazing?</h2>
    <p>Get started with Pulse in seconds. No configuration required.</p>
    <div class="cta-actions">
      <a href="/docs" class="btn-primary">Read the Docs →</a>
      <a href="/examples" class="btn-outline">See Examples</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-brand">
