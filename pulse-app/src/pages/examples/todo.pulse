<script>
  import Navbar from '../../components/Navbar.pulse';
  
  const [todos, setTodos] = createSignal([
    { id: 1, text: 'Learn Pulse Framework', done: true },
    { id: 2, text: 'Build an amazing app', done: false },
    { id: 3, text: 'Deploy to production', done: false }
  ]);
  const [newTodo, setNewTodo] = createSignal('');
  
  function addTodo(e) {
    e.preventDefault();
    const text = newTodo.trim();
    if (!text) return;
    
    const id = Date.now();
    setTodos([...todos, { id, text, done: false }]);
    setNewTodo('');
  }
  
  function toggleTodo(id) {
    setTodos(todos.map(t => 
      t.id === id ? { ...t, done: !t.done } : t
    ));
  }
  
  function deleteTodo(id) {
    setTodos(todos.filter(t => t.id !== id));
  }
  
  const remaining = createMemo(() => todos.filter(t => !t.done).length);
</script>

<Navbar />

<main class="example-page">
  <a href="/examples" class="back">← Back to Examples</a>
  
  <div class="example-header">
    <span class="icon">✅</span>
    <div>
      <h1>Todo Application</h1>
      <p class="desc">Full CRUD app with List primitive, forms, and filtering</p>
    </div>
  </div>

  <div class="demo-section">
    <h2>Live Demo</h2>
    <div class="demo-box">
      <div class="todo-header">
        <h3>My Todos</h3>
        <span class="remaining">{remaining()} remaining</span>
      </div>
      
      <form class="add-form" onSubmit={addTodo}>
        <input 
          type="text"
          value={newTodo}
          onInput={e => setNewTodo(e.target.value)}
          placeholder="What needs to be done?"
        />
        <button type="submit">Add</button>
      </form>
      
      <ul class="todo-list">
        <List each={todos} as="todo" key={todo.id}>
          <li class={todo.done ? 'done' : ''}>
            <input 
              type="checkbox" 
              checked={todo.done}
              onChange={() => toggleTodo(todo.id)}
            />
            <span class="todo-text">{todo.text}</span>
            <button class="delete" onClick={() => deleteTodo(todo.id)}>×</button>
          </li>
        </List>
      </ul>
    </div>
  </div>

  <div class="code-section">
    <h2>Code</h2>
    <pre><code is:raw>&lt;script&gt;
  const [todos, setTodos] = createSignal([
    { id: 1, text: 'Learn Pulse', done: false }
  ]);
  const [newTodo, setNewTodo] = createSignal('');
  
  function addTodo(e) {
    e.preventDefault();
    const text = newTodo.trim();
    if (!text) return;
    
    setTodos([...todos, { id: Date.now(), text, done: false }]);
    setNewTodo('');
  }
  
  function toggleTodo(id) {
    setTodos(todos.map(t =&gt; 
      t.id === id ? { ...t, done: !t.done } : t
    ));
  }
  
  function deleteTodo(id) {
    setTodos(todos.filter(t =&gt; t.id !== id));
  }
  
  const remaining = createMemo(() =&gt; 
    todos.filter(t =&gt; !t.done).length
  );
&lt;/script&gt;

&lt;form onSubmit={addTodo}&gt;
  &lt;input 
    value={newTodo}
    onInput={e =&gt; setNewTodo(e.target.value)}
    placeholder="What needs to be done?"
  /&gt;
  &lt;button type="submit"&gt;Add&lt;/button&gt;
&lt;/form&gt;

&lt;p&gt;{remaining} items remaining&lt;/p&gt;

&lt;List each={todos} as="todo"&gt;
  &lt;li&gt;
    &lt;input 
      type="checkbox" 
      checked={todo.done}
      onChange={() =&gt; toggleTodo(todo.id)}
    /&gt;
    &lt;span&gt;{todo.text}&lt;/span&gt;
    &lt;button onClick={() =&gt; deleteTodo(todo.id)}&gt;×&lt;/button&gt;
  &lt;/li&gt;
&lt;/List&gt;</code></pre>
  </div>

  <div class="features-section">
    <h2>Features Used</h2>
    <div class="feature-list">
      <div class="feature">
        <h4>List Primitive</h4>
        <p>Efficiently renders arrays with automatic updates</p>
      </div>
      <div class="feature">
        <h4>Form Handling</h4>
        <p>Two-way binding for inputs with onSubmit</p>
      </div>
      <div class="feature">
        <h4>createMemo</h4>
        <p>Computed remaining count updates automatically</p>
      </div>
    </div>
  </div>
</main>

<style>
  body { background: #f8fafc; font-family: system-ui, sans-serif; margin: 0; }
  .example-page { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
  .back { display: inline-block; color: #6b46c1; text-decoration: none; font-weight: 600; margin-bottom: 30px; }
  .back:hover { color: #5a3ba8; }
