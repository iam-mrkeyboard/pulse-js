<script>
  import Navbar from '../../components/Navbar.pulse';
  
  const [count, setCount] = createSignal(0);
  const doubled = createMemo(() => count * 2);
  const tripled = createMemo(() => count * 3);
  
  function increment() { setCount(c => c + 1); }
  function decrement() { setCount(c => c - 1); }
  function reset() { setCount(0); }
</script>

<Navbar />

<main class="example-page">
  <a href="/examples" class="back">← Back to Examples</a>
  
  <div class="example-header">
    <span class="icon">🔢</span>
    <div>
      <h1>Interactive Counter</h1>
      <p class="desc">Learn signals, effects, and memos with a classic counter example</p>
    </div>
  </div>

  <div class="demo-section">
    <h2>Live Demo</h2>
    <div class="demo-box">
      <div class="counter-display">
        <span class="count">{count}</span>
      </div>
      
      <div class="button-group">
        <button class="btn-action" onClick={decrement}>−</button>
        <button class="btn-reset" onClick={reset}>Reset</button>
        <button class="btn-action" onClick={increment}>+</button>
      </div>
      
      <div class="derived-values">
        <div class="derived-item">
          <span class="label">Doubled</span>
          <span class="value">{doubled}</span>
        </div>
        <div class="derived-item">
          <span class="label">Tripled</span>
          <span class="value">{tripled}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="code-section">
    <h2>Code</h2>
    <pre><code>&lt;script&gt;
  const [count, setCount] = createSignal(0);
  
  // Derived values - only recompute when count changes
  const doubled = createMemo(() => count * 2);
  const tripled = createMemo(() => count * 3);
  
  // Log changes (side effect)
  createEffect(() => {
    console.log('Count changed to:', count);
  });
  
  function increment() { setCount(c => c + 1); }
  function decrement() { setCount(c => c - 1); }
  function reset() { setCount(0); }
&lt;/script&gt;

&lt;div class="counter"&gt;
  &lt;span class="count"&gt;{count}&lt;/span&gt;
  
  &lt;div class="buttons"&gt;
    &lt;button onClick={decrement}&gt;−&lt;/button&gt;
    &lt;button onClick={reset}&gt;Reset&lt;/button&gt;
    &lt;button onClick={increment}&gt;+&lt;/button&gt;
  &lt;/div&gt;
  
  &lt;div class="derived"&gt;
    &lt;p&gt;Doubled: {doubled}&lt;/p&gt;
    &lt;p&gt;Tripled: {tripled}&lt;/p&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
  </div>

  <div class="features-section">
    <h2>Features Used</h2>
    <div class="feature-list">
      <div class="feature">
        <h4>createSignal</h4>
        <p>Core reactive primitive for mutable state</p>
      </div>
      <div class="feature">
        <h4>createMemo</h4>
        <p>Derived values that cache and recompute efficiently</p>
      </div>
      <div class="feature">
        <h4>createEffect</h4>
        <p>Side effects that run when dependencies change</p>
      </div>
    </div>
  </div>
</main>

