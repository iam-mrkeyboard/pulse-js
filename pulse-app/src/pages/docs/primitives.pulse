<script>
  import Navbar from '../../components/Navbar.pulse';
</script>

<Navbar />

<main class="docs-page">
  <aside class="sidebar">
    <h3>Primitives</h3>
    <nav>
      <a href="/docs/primitives" class="active">Overview</a>
      <a href="/docs/primitives#list">List</a>
      <a href="/docs/primitives#show">Show</a>
      <a href="/docs/primitives#portal">Portal</a>
    </nav>
    <a href="/docs" class="back">← All Docs</a>
  </aside>
  
  <article class="content">
    <h1>Built-in Primitives</h1>
    <p class="lead">Pulse provides optimized UI primitives that handle common patterns like lists, conditionals, and portals with maximum efficiency.</p>

    <section id="list">
      <h2>List Primitive</h2>
      <p>The <code>&lt;List&gt;</code> primitive efficiently renders arrays with automatic diffing and minimal DOM updates.</p>
      
      <div class="demo-box">
        <div class="demo-label">Live Example</div>
        <div class="demo-content">
          <ul class="demo-list">
            <li>🍎 Apple - $1.20</li>
            <li>🍌 Banana - $0.80</li>
            <li>🍒 Cherry - $2.50</li>
          </ul>
        </div>
      </div>

      <div class="code-block">
        <div class="code-header">
          <span class="label">Basic List</span>
        </div>
        <pre><code>&lt;script&gt;
  const [items, setItems] = createSignal([
    { id: 1, name: 'Apple', price: 1.2 },
    { id: 2, name: 'Banana', price: 0.8 },
    { id: 3, name: 'Cherry', price: 2.5 }
  ]);
&lt;/script&gt;

&lt;ul&gt;
  &lt;List each={items} as="item"&gt;
    &lt;li&gt;
      &lt;span&gt;{item.name}&lt;/span&gt;
      &lt;span&gt;${item.price.toFixed(2)}&lt;/span&gt;
    &lt;/li&gt;
  &lt;/List&gt;
&lt;/ul&gt;</code></pre>
      </div>

      <h3>Adding & Removing Items</h3>
      <div class="code-block">
        <pre><code>function addItem() {
  const newId = items().length + 1;
  setItems([...items(), { id: newId, name: 'New', price: 0 }]);
}

function removeItem(id) {
  setItems(items().filter(item => item.id !== id));
}

// In template
&lt;button onClick={() => removeItem(item.id)}&gt;Delete&lt;/button&gt;</code></pre>
      </div>

      <div class="info-box">
        <h4>⚡ Performance</h4>
        <p>List uses keyed reconciliation. When items change, only affected DOM nodes update - not the entire list.</p>
      </div>
    </section>

    <section id="show">
      <h2>Show Primitive</h2>
      <p>The <code>&lt;Show&gt;</code> primitive conditionally renders content based on a boolean expression.</p>
      
      <div class="demo-box">
        <div class="demo-label">Live Example</div>
        <div class="demo-content">
          <div class="demo-toggle">
            <span class="toggle-label">Visible: ON</span>
            <div class="visible-content">
              ✨ This content is conditionally rendered!
            </div>
          </div>
        </div>
      </div>

      <div class="code-block">
        <div class="code-header">
          <span class="label">Basic Show</span>
        </div>
        <pre><code>&lt;script&gt;
  const [isVisible, setIsVisible] = createSignal(true);
&lt;/script&gt;

&lt;button onClick={() => setIsVisible(!isVisible())}&gt;
  Toggle
&lt;/button&gt;

&lt;Show when={isVisible}&gt;
  &lt;div class="content"&gt;
    This content is conditionally rendered!
  &lt;/div&gt;
&lt;/Show&gt;</code></pre>
      </div>

      <h3>With Fallback</h3>
      <div class="code-block">
        <pre><code>&lt;Show 
  when={isLoggedIn} 
  fallback={&lt;p&gt;Please log in to continue.&lt;/p&gt;}
&gt;
  &lt;Dashboard /&gt;
&lt;/Show&gt;</code></pre>
      </div>

      <h3>Complex Conditions</h3>
      <div class="code-block">
        <pre><code>const [count, setCount] = createSignal(0);

&lt;Show when={count > 10}&gt;
  &lt;div class="alert"&gt;Count is getting high!&lt;/div&gt;
&lt;/Show&gt;

&lt;Show when={user() && user().isAdmin}&gt;
  &lt;AdminPanel /&gt;
&lt;/Show&gt;</code></pre>
      </div>
    </section>

    <section id="portal">
      <h2>Portal Primitive</h2>
      <p>The <code>&lt;Portal&gt;</code> primitive renders content to a different location in the DOM tree.</p>
      
      <div class="code-block">
        <div class="code-header">
          <span class="label">Modal Example</span>
        </div>
        <pre><code>&lt;script&gt;
  const [showModal, setShowModal] = createSignal(false);
&lt;/script&gt;

&lt;button onClick={() => setShowModal(true)}&gt;
  Open Modal
&lt;/button&gt;

&lt;Show when={showModal}&gt;
  &lt;Portal target="body"&gt;
    &lt;div class="modal-overlay"&gt;
      &lt;div class="modal"&gt;
        &lt;h2&gt;Modal Title&lt;/h2&gt;
        &lt;p&gt;Modal content here...&lt;/p&gt;
        &lt;button onClick={() => setShowModal(false)}&gt;
          Close
        &lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/Portal&gt;
&lt;/Show&gt;</code></pre>
      </div>

      <div class="info-box">
        <h4>🎯 Use Cases</h4>
        <ul>
          <li>Modals and dialogs</li>
          <li>Tooltips and popovers</li>
          <li>Full-screen overlays</li>
          <li>Dropdown menus that need to escape overflow</li>
        </ul>
      </div>
    </section>

    <section id="comparison">
      <h2>Quick Reference</h2>
      <table>
        <thead>
          <tr>
            <th>Primitive</th>
            <th>Purpose</th>
            <th>Key Attribute</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>&lt;List&gt;</code></td>
            <td>Render arrays</td>
            <td><code>each={array}</code></td>
          </tr>
          <tr>
            <td><code>&lt;Show&gt;</code></td>
            <td>Conditional render</td>
            <td><code>when={boolean}</code></td>
          </tr>
          <tr>
            <td><code>&lt;Portal&gt;</code></td>
            <td>Render elsewhere</td>
            <td><code>target="selector"</code></td>
          </tr>
        </tbody>
      </table>
    </section>
  </article>
</main>

