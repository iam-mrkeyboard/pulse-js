</script>

<Navbar />

<main class="docs-page">
  <aside class="sidebar">
    <h3>Forms</h3>
    <nav>
      <a href="/docs/forms" class="active">Overview</a>
      <a href="/docs/forms#text-inputs">Text Inputs</a>
      <a href="/docs/forms#checkboxes">Checkboxes</a>
      <a href="/docs/forms#selects">Select/Radio</a>
      <a href="/docs/forms#validation">Validation</a>
    </nav>
    <a href="/docs" class="back">← All Docs</a>
  </aside>
  
  <article class="content">
    <h1>Forms & Two-Way Binding</h1>
    <p class="lead">Build interactive forms with Pulse's reactive two-way binding. Connect form inputs directly to signals for seamless data flow.</p>

    <section id="text-inputs">
      <h2>Text Inputs</h2>
      <p>Use <code>value</code> and <code>onInput</code> for two-way text binding.</p>
      
      <div class="demo-box">
        <div class="demo-label">Live Example</div>
        <div class="demo-content">
          <input type="text" class="demo-input" placeholder="Type your name..." value="John Doe" />
          <p class="demo-preview">Hello, <strong>John Doe</strong>! 👋</p>
        </div>
      </div>

      <div class="code-block">
        <div class="code-header">
          <span class="label">Text Input Binding</span>
        </div>
        <pre><code>&lt;script&gt;
  const [name, setName] = createSignal('');
&lt;/script&gt;

&lt;input 
  type="text"
  value={name} 
  onInput={e => setName(e.target.value)}
  placeholder="Enter your name"
/&gt;

&lt;p&gt;Hello, &lt;strong&gt;{name}&lt;/strong&gt;!&lt;/p&gt;</code></pre>
      </div>

      <h3>Email & Password</h3>
      <div class="code-block">
        <pre><code>const [email, setEmail] = createSignal('');
const [password, setPassword] = createSignal('');

&lt;input 
  type="email"
  value={email}
  onInput={e => setEmail(e.target.value)}
  placeholder="you@example.com"
/&gt;

&lt;input 
  type="password"
  value={password}
  onInput={e => setPassword(e.target.value)}
  placeholder="••••••••"
/&gt;</code></pre>
      </div>
    </section>

    <section id="checkboxes">
      <h2>Checkboxes</h2>
      <p>Use <code>checked</code> and <code>onChange</code> for boolean toggles.</p>
      
      <div class="demo-box">
        <div class="demo-label">Live Example</div>
        <div class="demo-content">
          <label class="demo-checkbox">
            <input type="checkbox" checked />
            <span>Subscribe to newsletter</span>
          </label>
          <p class="demo-status">Status: <span class="on">Subscribed ✓</span></p>
        </div>
      </div>

      <div class="code-block">
        <div class="code-header">
          <span class="label">Checkbox Binding</span>
        </div>
        <pre><code>&lt;script&gt;
  const [subscribed, setSubscribed] = createSignal(false);
&lt;/script&gt;

&lt;label&gt;
  &lt;input 
    type="checkbox"
    checked={subscribed}
    onChange={e => setSubscribed(e.target.checked)}
  /&gt;
  Subscribe to newsletter
&lt;/label&gt;

&lt;p&gt;Status: {subscribed ? 'Subscribed' : 'Not subscribed'}&lt;/p&gt;</code></pre>
      </div>
    </section>

    <section id="selects">
      <h2>Select & Radio Buttons</h2>
      
      <h3>Select Dropdown</h3>
      <div class="demo-box">
        <div class="demo-label">Live Example</div>
        <div class="demo-content">
          <select class="demo-select">
            <option value="user">User</option>
            <option value="admin" selected>Admin</option>
            <option value="moderator">Moderator</option>
          </select>
          <p class="demo-preview">Selected role: <strong>Admin</strong></p>
        </div>
      </div>

      <div class="code-block">
        <pre><code>&lt;script&gt;
  const [role, setRole] = createSignal('user');
&lt;/script&gt;

&lt;select 
  value={role} 
  onChange={e => setRole(e.target.value)}
&gt;
  &lt;option value="user"&gt;User&lt;/option&gt;
  &lt;option value="admin"&gt;Admin&lt;/option&gt;
  &lt;option value="moderator"&gt;Moderator&lt;/option&gt;
&lt;/select&gt;</code></pre>
      </div>

      <h3>Radio Buttons</h3>
      <div class="code-block">
        <pre><code>&lt;script&gt;
  const [theme, setTheme] = createSignal('light');
&lt;/script&gt;

&lt;label&gt;
  &lt;input 
    type="radio" 
    name="theme"
    checked={theme === 'light'}
    onChange={() => setTheme('light')}
  /&gt;
  Light
&lt;/label&gt;

&lt;label&gt;
  &lt;input 
    type="radio" 
    name="theme"
    checked={theme === 'dark'}
    onChange={() => setTheme('dark')}
  /&gt;
  Dark
&lt;/label&gt;</code></pre>
      </div>
    </section>

    <section id="validation">
      <h2>Form Validation</h2>
      <p>Use <code>createMemo</code> for reactive validation.</p>

      <div class="code-block">
        <div class="code-header">
          <span class="label">Validated Form</span>
        </div>
        <pre><code>&lt;script&gt;
  const [email, setEmail] = createSignal('');
  const [password, setPassword] = createSignal('');
  
  const emailValid = createMemo(() => 
    email.includes('@') && email.includes('.')
  );
  
  const passwordValid = createMemo(() => 
    password.length >= 8
  );
  
  const formValid = createMemo(() => 
    emailValid && passwordValid
  );
  
  function handleSubmit(e) {
    e.preventDefault();
    if (!formValid) return;
    
    // Submit form...
    console.log('Submitting:', { email: email, password: password });
  }
&lt;/script&gt;

&lt;form onSubmit={handleSubmit}&gt;
  &lt;div class="field"&gt;
    &lt;input 
      type="email"
      value={email}
      onInput={e => setEmail(e.target.value)}
      class={emailValid ? 'valid' : 'invalid'}
    /&gt;
    &lt;Show when={!emailValid && email.length > 0}&gt;
      &lt;span class="error"&gt;Enter a valid email&lt;/span&gt;
    &lt;/Show&gt;
  &lt;/div&gt;
  
  &lt;div class="field"&gt;
    &lt;input 
      type="password"
      value={password}
      onInput={e => setPassword(e.target.value)}
    /&gt;
    &lt;Show when={!passwordValid && password.length > 0}&gt;
      &lt;span class="error"&gt;Min 8 characters required&lt;/span&gt;
    &lt;/Show&gt;
  &lt;/div&gt;
  
  &lt;button type="submit" disabled={!formValid}&gt;
    Submit
  &lt;/button&gt;
&lt;/form&gt;</code></pre>
      </div>

      <div class="info-box">
        <h4>💡 Validation Tips</h4>
        <ul>
          <li>Use <code>createMemo</code> for validation rules</li>
          <li>Combine multiple validations with logical AND</li>
          <li>Show errors only after user interaction</li>
          <li>Disable submit button until form is valid</li>
        </ul>
      </div>
    </section>
  </article>
</main>

