  .demo-content { padding: 20px; }
  .demo-input { width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; margin-bottom: 15px; }
  .demo-input:focus { outline: none; border-color: #6b46c1; }
