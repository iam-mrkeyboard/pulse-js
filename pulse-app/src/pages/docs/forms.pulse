  .demo-status { margin-top: 15px; color: #6b7280; }
  .demo-status .on { color: #10b981; font-weight: 600; }
  .demo-select { padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; width: 100%; margin-bottom: 15px; }

  .code-block { background: #1f2937; border-radius: 10px; overflow: hidden; margin: 20px 0; }
