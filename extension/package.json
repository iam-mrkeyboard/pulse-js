{
  "name": "pulse-framework",
  "displayName": "Pulse Framework",
  "description": "Advanced language support for .pulse files with IntelliSense, diagnostics, and more",
  "version": "1.5.0",
  "publisher": "pulse",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/pulse-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "pulse",
    "jsx",
    "reactive",
    "framework",
    "typescript",
    "bun",
    "signals"
  ],
  "activationEvents": [
    "onLanguage:pulse"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pulse",
        "aliases": [
          "Pulse",
          "pulse"
        ],
        "extensions": [
          ".pulse"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pulse",
        "scopeName": "source.pulse",
        "path": "./syntaxes/pulse.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css",
          "meta.embedded.expression.pulse": "javascript",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "pulse",
        "path": "./snippets/pulse.json"
      }
    ],
    "configurationDefaults": {
      "[pulse]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.suggest.insertMode": "replace",
        "editor.acceptSuggestionOnEnter": "on"
      }
    },
    "path": "./syntaxes/injection.json",
    "scopeName": "pulse.injection",
    "injectTo": [
      "source.pulse"
    ],
    "configuration": {
      "title": "Pulse Framework",
      "properties": {
        "pulse.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable error diagnostics for Pulse files"
        },
        "pulse.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable autocomplete suggestions"
        },
        "pulse.autocomplete.cssInStyle": {
          "type": "boolean",
          "default": true,
          "description": "Enable CSS property suggestions in style={{}} objects"
        },
        "pulse.validate.imports": {
          "type": "boolean",
          "default": true,
          "description": "Validate component imports"
        },
        "pulse.suggest.htmlAttributes": {
          "type": "boolean",
          "default": true,
          "description": "Show HTML attribute suggestions"
        },
        "pulse.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b client server",
    "watch": "tsc -b client server -w",
    "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
    "test": "npm run compile && node ./client/out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
