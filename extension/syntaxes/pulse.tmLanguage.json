{
  "scopeName": "source.pulse",
  "name": "Pulse",
  "patterns": [
    { "include": "#script-block" },
    { "include": "#style-block" },
    { "include": "#html-content" }
  ],
  "repository": {
    "script-block": {
      "begin": "(<)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=>)(?!\\s*</script)",
          "end": "(?=</script)",
          "name": "meta.embedded.block.javascript",
          "contentName": "source.js",
          "patterns": [{ "include": "source.js" }]
        }
      ]
    },
    "style-block": {
      "begin": "(<)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "begin": "(?<=>)(?!\\s*</style)",
          "end": "(?=</style)",
          "name": "meta.embedded.block.css",
          "contentName": "source.css",
          "patterns": [{ "include": "source.css" }]
        }
      ]
    },
    "html-content": {
      "patterns": [
        { "include": "#component-tag" },
        { "include": "#html-tag" },
        { "include": "#jsx-expression" },
        { "include": "#comment" }
      ]
    },
    "component-tag": {
      "begin": "(<)([A-Z][a-zA-Z0-9]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": {
          "name": "entity.name.tag.component.pulse support.class.component.pulse"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.tag.component.pulse",
      "patterns": [{ "include": "#tag-attributes" }]
    },
    "html-tag": {
      "begin": "(</?)(Show|List|Portal|Suspense|ErrorBoundary|head|title|meta|link|script|style|body|div|span|p|h[1-6]|ul|ol|li|a|img|button|input|textarea|select|option|form|label|table|thead|tbody|tr|td|th|nav|header|footer|section|article|aside|main|figure|figcaption|video|audio|source|canvas|svg|path|circle|rect|line|polyline|polygon|ellipse|g|defs|use|symbol|text|tspan|pre|code|blockquote|hr|br|strong|em|b|i|u|s|mark|small|sub|sup|kbd|samp|var|abbr|address|cite|dfn|del|ins|time|details|summary|dialog|menu|menuitem|picture|iframe|embed|object|param|fieldset|legend|datalist|output|progress|meter)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "name": "meta.tag.html",
      "patterns": [{ "include": "#tag-attributes" }]
    },
    "tag-attributes": {
      "patterns": [
        { "include": "#jsx-expression" },
        { "include": "#attribute-name" },
        { "include": "#attribute-value" }
      ]
    },
    "attribute-name": {
      "match": "\\b([-a-zA-Z0-9:]+)(?=\\s*=)",
      "name": "entity.other.attribute-name.html"
    },
    "attribute-value": {
      "patterns": [
        {
          "begin": "=\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.html" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.html" }
          },
          "name": "string.quoted.double.html"
        },
        {
          "begin": "='",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.html" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.html" }
          },
          "name": "string.quoted.single.html"
        }
      ]
    },
    "jsx-expression": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.pulse meta.brace.curly.js"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.pulse meta.brace.curly.js"
        }
      },
      "patterns": [
        {
          "begin": "(?<=\\{)",
          "end": "(?=\\})",
          "name": "meta.embedded.expression.pulse",
          "contentName": "source.js",
          "patterns": [{ "include": "source.js" }]
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "<!--",
          "end": "-->",
          "name": "comment.block.html"
        }
      ]
    }
  }
}
