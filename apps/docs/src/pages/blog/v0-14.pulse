  }

  .header {
    text-align: center;
    margin-bottom: 60px;
  }

  .date {
    color: #6b46c1;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin: 10px 0 20px;
    background: linear-gradient(135deg, #111827 0%, #4b5563 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 1.5rem;
    color: #6b7280;
    font-weight: 400;
    max-width: 600px;
    margin: 0 auto;
  }

  .body {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  h2 {
    font-size: 2rem;
    margin-top: 50px;
    margin-bottom: 25px;
    color: #111827;
  }

  .highlight-box {
    background: #f3f4f6;
    border-left: 4px solid #6b46c1;
    padding: 20px;
    margin: 40px 0;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  code {
    background: #1f2937;
    color: #a5b4fc;
    padding: 15px;
    border-radius: 6px;
    font-family: 'Fira Code', monospace;
    display: block;
    width: fit-content;
    white-space: pre;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  ul {
    list-style-type: none;
    padding: 0;
  }

  ul li {
    padding-left: 24px;
    position: relative;
    margin-bottom: 12px;
  }

  ul li::before {
    content: "•";
    color: #6b46c1;
    font-weight: bold;
    font-size: 1.5rem;
    position: absolute;
    left: 0;
    top: -5px;
  }

  /* Table Styles */
  .table-container {
    overflow-x: auto;
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    background: white;
  }
  
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.95rem;
    overflow: hidden;
  }
  
  th, td {
    padding: 1rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid #f3f4f6;
  }
  
  th {
    background: #6b46c1;
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  
  th:first-child {
    border-top-left-radius: 8px;
  }
  th:last-child {
    border-top-right-radius: 8px;
  }
  
  tr:last-child td {
    border-bottom: none;
  }
  
  tr:nth-child(even) {
    background: #f9fafb;
    color: #1f2937;
  }
  
  tr:hover td {
    background: #f3e8ff;
    color: #1f2937;
  }
</style>
