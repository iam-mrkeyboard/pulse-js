<script>
  import Navbar from '../../components/Navbar.pulse';
  
  const [activeTab, setActiveTab] = createSignal('home');
</script>

<Navbar />

<main class="example-page">
  <a href="/examples" class="back">← Back to Examples</a>
  
  <div class="example-header">
    <span class="icon">📑</span>
    <div>
      <h1>Tabs Component</h1>
      <p class="desc">Tab navigation with Show primitive for conditional rendering</p>
    </div>
  </div>

  <div class="demo-section">
    <h2>Live Demo</h2>
    <div class="demo-box">
      <div class="tabs">
        <button 
          class={activeTab === 'home' ? 'tab active' : 'tab'}
          onClick={() => setActiveTab('home')}
        >Home</button>
        <button 
          class={activeTab === 'about' ? 'tab active' : 'tab'}
          onClick={() => setActiveTab('about')}
        >About</button>
        <button 
          class={activeTab === 'contact' ? 'tab active' : 'tab'}
          onClick={() => setActiveTab('contact')}
        >Contact</button>
      </div>
      
      <div class="tab-content">
        <Show when={activeTab === 'home'}>
          <div class="panel">
            <h3>🏠 Welcome Home</h3>
            <p>This is the home tab content. It appears when the "Home" tab is selected.</p>
            <p>Click other tabs to switch content!</p>
          </div>
        </Show>
        
        <Show when={activeTab === 'about'}>
          <div class="panel">
            <h3>ℹ️ About Us</h3>
            <p>Learn more about our company and mission.</p>
            <p>We build amazing tools for developers.</p>
          </div>
        </Show>
        
        <Show when={activeTab === 'contact'}>
          <div class="panel">
            <h3>📧 Contact</h3>
            <p>Get in touch with our team.</p>
            <p>Email: hello@example.com</p>
          </div>
        </Show>
      </div>
    </div>
  </div>

  <div class="code-section">
    <h2>Code</h2>
    <pre><code is:raw>&lt;script&gt;
  const [activeTab, setActiveTab] = createSignal('home');
&lt;/script&gt;

&lt;div class="tabs"&gt;
  &lt;button 
    class={activeTab === 'home' ? 'tab active' : 'tab'}
    onClick={() =&gt; setActiveTab('home')}
  &gt;Home&lt;/button&gt;
  &lt;button 
    class={activeTab === 'about' ? 'tab active' : 'tab'}
    onClick={() =&gt; setActiveTab('about')}
  &gt;About&lt;/button&gt;
  &lt;button 
    class={activeTab === 'contact' ? 'tab active' : 'tab'}
    onClick={() =&gt; setActiveTab('contact')}
  &gt;Contact&lt;/button&gt;
&lt;/div&gt;

&lt;div class="content"&gt;
  &lt;Show when={activeTab === 'home'}&gt;
    &lt;div class="panel"&gt;
      &lt;h3&gt;Welcome Home&lt;/h3&gt;
      &lt;p&gt;Home tab content...&lt;/p&gt;
    &lt;/div&gt;
  &lt;/Show&gt;
  
  &lt;Show when={activeTab === 'about'}&gt;
    &lt;div class="panel"&gt;
      &lt;h3&gt;About Us&lt;/h3&gt;
      &lt;p&gt;About tab content...&lt;/p&gt;
    &lt;/div&gt;
  &lt;/Show&gt;
  
  &lt;Show when={activeTab === 'contact'}&gt;
    &lt;div class="panel"&gt;
      &lt;h3&gt;Contact&lt;/h3&gt;
      &lt;p&gt;Contact tab content...&lt;/p&gt;
    &lt;/div&gt;
  &lt;/Show&gt;
&lt;/div&gt;</code></pre>
  </div>

  <div class="features-section">
    <h2>Features Used</h2>
    <div class="feature-list">
      <div class="feature">
        <h4>Show Primitive</h4>
        <p>Conditionally render content based on active tab</p>
      </div>
      <div class="feature">
        <h4>Dynamic Classes</h4>
        <p>Ternary expressions for active tab styling</p>
      </div>
      <div class="feature">
        <h4>Event Handlers</h4>
        <p>onClick to switch between tabs</p>
      </div>
    </div>
  </div>
</main>

<style>
  body { background: #f8fafc; font-family: system-ui, sans-serif; margin: 0; }
  .example-page { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
  .back { display: inline-block; color: #6b46c1; text-decoration: none; font-weight: 600; margin-bottom: 30px; }
  .back:hover { color: #5a3ba8; }
