  .example-header .icon { font-size: 3rem; width: 80px; height: 80px; background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
  .example-header h1 { margin: 0 0 8px; color: #1f2937; }
  .example-header .desc { margin: 0; color: #6b7280; font-size: 1.1rem; }
