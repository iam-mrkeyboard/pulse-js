{
  "name": "pulse",
  "version": "0.15.0",
  "description": "The fastest web framework - 0-1.2KB runtime with islands architecture (Early Development)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pulse": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/core.js"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --sourcemap=none --external lightningcss && bun build ./src/cli/index.ts --outdir ./dist/cli --target bun --format esm --sourcemap=none --external lightningcss",
    "dev": "bun run src/cli/index.ts dev",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "link": "bun link",
    "unlink": "bun unlink",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "framework",
    "web",
    "islands",
    "ssr",
    "signals",
    "reactive",
    "fast",
    "lightweight",
    "compiler"
  ],
  "author": "Pulse Team",
  "license": "MIT",
  "dependencies": {
    "@types/acorn": "^6.0.4",
    "acorn": "^8.15.0",
    "estree-walker": "^3.0.3",
    "lightningcss": "^1.31.1",
    "picocolors": "^1.0.0",
    "terser": "^5.27.0",
    "ultrahtml": "^1.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "latest",
    "@types/node": "^20.11.5",
    "happy-dom": "^20.14.5",
    "puppeteer": "^25.12.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
